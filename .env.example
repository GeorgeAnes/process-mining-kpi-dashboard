# Deterministic analytics are the default.
LLM_MODE=off

# Optional LM Studio or other OpenAI-compatible local endpoint.
# 1. Start the LM Studio local server.
# 2. Load a chat model.
# 3. Set LLM_MODE=openai_compatible.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model

# Frontend override if needed. The Vite dev server proxies /api to the backend by default.
VITE_API_BASE_URL=/api
